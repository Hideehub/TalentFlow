# Copy to .env for local development. On Render, set these in the dashboard.
# Never commit a real .env.

# --- Core -------------------------------------------------------------------
# Required when DEBUG is False (startup fails without it). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-secret-key

# Defaults to False. Use True only for local development.
DEBUG=True

# Comma-separated host names. Render's own hostname is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (with scheme) allowed to POST forms, e.g. a custom domain:
#   https://talentflow.example.com
# Render's own https:// hostname is added automatically.
CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------
# Production (Neon): one URL. Takes priority over the DB_* variables below.
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# SSL is required for DATABASE_URL when DEBUG is False. Set False only for a local
# or CI database without SSL.
# DATABASE_SSL_REQUIRE=False

# Local development without DATABASE_URL:
DB_NAME=talentflow_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

# --- Security (only used when DEBUG is False) -----------------------------------
# HSTS max-age in seconds. Start short; raise to 31536000 once HTTPS is confirmed.
SECURE_HSTS_SECONDS=3600
# Only enable after a long max-age has been running; preloading is hard to undo.
# SECURE_HSTS_PRELOAD=False
# Redirect HTTP to HTTPS (default True when DEBUG is False).
# SECURE_SSL_REDIRECT=True

# --- Demo -------------------------------------------------------------------
# Shows one-click demo logins and makes build.sh run seed_demo. Defaults to False.
DEMO_MODE=False

# --- Resume storage (optional) -------------------------------------------------
# Leave RESUMES_S3_BUCKET empty to store resumes in ./private_media on local disk.
# Set all of these to use a private Cloudflare R2 (or AWS S3) bucket instead.
RESUMES_S3_BUCKET=
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (leave empty for AWS S3)
RESUMES_S3_ENDPOINT_URL=
RESUMES_S3_ACCESS_KEY_ID=
RESUMES_S3_SECRET_ACCESS_KEY=
# "auto" for R2; the bucket's region (e.g. eu-west-2) for AWS S3.
RESUMES_S3_REGION=auto

# --- Logging ----------------------------------------------------------------
# LOG_LEVEL=INFO
